---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTA from '../components/CTA.astro';
import { pathways } from '../data/content';
---
<BaseLayout title="Academics and curriculum" description="Explore the primary, secondary, IGCSE and Cambridge Advanced learning stages set out in MITstem International School's 2019–2020 prospectus.">
  <section class="page-hero"><div class="container page-hero__content"><p class="eyebrow eyebrow--white"><span class="eyebrow__line"></span>Our academic approach</p><h1>Learning that grows with you.</h1><p>From the first discoveries of primary school to more specialised secondary study, explore the learning stages described in the MITstem prospectus.</p></div></section>
  <section class="section-space"><div class="container academic-intro"><div><p class="eyebrow"><span class="eyebrow__line"></span>A curious way to learn</p><h2>Strong foundations. New perspectives.</h2><p>The MITstem International School sets out a dynamic curriculum designed to build intellectual curiosity and a lasting love of learning. It connects foundational subjects with languages, creative expression, computing and STEM-related areas of study.</p><p>The educational pathway is organised around Cambridge Primary, Cambridge Secondary 1, Cambridge Secondary 2 / IGCSE and Cambridge Advanced stages.</p><a class="text-link" href="/stem/">Explore STEM subjects <span aria-hidden="true">→</span></a></div><img src="/images/science-discovery.webp" alt="Young learner experimenting with a microscope" width="650" height="670" loading="lazy" /></div></section>
  <section class="section-space section-soft"><div class="container"><SectionHeading eyebrow="At every stage" title="Your learning journey." description="Subject groupings and ages are based on the 2019–2020 brochure. The listed areas are indicative, not a confirmed current timetable." /><div class="course-list">{pathways.map((item) => <article class="course-card"><div class="course-card__header"><span class="course-card__index">{item.number}</span><div><h3>{item.title}</h3><p>{item.stage} · {item.years}</p></div></div><div class="course-card__body"><p>{item.summary}</p><div class="subject-tags">{item.subjects.map(subject => <span>{subject}</span>)}</div><div class="course-card__age">{item.ages}</div></div></article>)}</div></div></section>
  <section class="section-space"><div class="container"><SectionHeading eyebrow="Learning experiences" title="More than a list of subjects." description="The original educational model presents learning as a combination of knowledge, practical experience and personal development." /><div class="values-grid"><article class="value-box"><span class="value-box__icon">A</span><h3>Core knowledge</h3><p>Building strong capabilities in languages, mathematics and science.</p></article><article class="value-box"><span class="value-box__icon">✳</span><h3>Creative expression</h3><p>Making room for arts, drama, experimentation and discovery.</p></article><article class="value-box"><span class="value-box__icon">⌘</span><h3>Digital literacy</h3><p>Introducing ICT and technology as tools for learning and creation.</p></article><article class="value-box"><span class="value-box__icon">↗</span><h3>Future pathways</h3><p>Encouraging students to connect learning with their aspirations.</p></article></div></div></section>
  <CTA title="Find the right next step." description="Ask about current programme availability, age groups, entry requirements and admissions." />
</BaseLayout>
