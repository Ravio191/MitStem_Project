---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTA from '../components/CTA.astro';
---
<BaseLayout title="About our school" description="Learn about MITstem International School's vision, mission, community values and technical education heritage as presented in its 2019–2020 prospectus.">
  <section class="page-hero page-hero--image"><img class="page-hero__side-image" src="/images/science-discovery.webp" alt="" aria-hidden="true"/><div class="container page-hero__content"><p class="eyebrow eyebrow--white"><span class="eyebrow__line"></span>Our school vision</p><h1>Education with purpose. Curiosity without limits.</h1><p>Learn more about the ideas, people-first values and technology-led approach behind MITstem International School.</p></div></section>

  <section class="section-space"><div class="container story-grid"><div><p class="eyebrow"><span class="eyebrow__line"></span>Who we aspire to be</p><h2>Creating experts for the future.</h2><p class="story-grid__lead">A friendly, happy school community where students feel encouraged to learn, question, create and grow.</p></div><div class="story-grid__copy"><p>The MITstem describes a school where respect, empathy, creativity and independent learning are central to the educational experience.</p><p>Alongside a rigorou academic programme, the concept includes clubs, trips, work experience, enrichment and social development. Learning is presented as a partnership between students, educators, families and the community.</p><p>The focus is on helping young people become knowledgeable, confident, curious and ready to take on new opportunities.</p><a class="text-link" href="/academics/">Discover the learning pathway <span aria-hidden="true">→</span></a></div></div></section>

  <section class="section-space section-soft"><div class="container"><SectionHeading eyebrow="What guides us" title="Our vision and mission." description="Guiding statements adapted from the original MITstem prospectus." /><div class="mission-cards"><article class="mission-card"><span class="mission-card__index">01 / VISION</span><h3>A global outlook</h3><p>To be a global technology training institution and STEM international school offering education and career advancement that contributes to future opportunities.</p></article><article class="mission-card"><span class="mission-card__index">02 / MISSION</span><h3>Learning strengthened by technology</h3><p>To provide meticulous, technologically enhanced curriculum and learning experiences, while developing quality, knowledge and skills for learner empowerment, professional development and global competitiveness.</p></article></div></div></section>

  <section class="section-space"><div class="container"><SectionHeading eyebrow="The school experience" title="A place to belong, and a place to become." description="A well-rounded education is about both academic achievement and the person each student becomes." /><div class="values-grid"><article class="value-box"><span class="value-box__icon" aria-hidden="true">♡</span><h3>Respect</h3><p>Learning to value people, perspectives and the community around us.</p></article><article class="value-box"><span class="value-box__icon" aria-hidden="true">◎</span><h3>Empathy</h3><p>Developing understanding, teamwork and supportive relationships.</p></article><article class="value-box"><span class="value-box__icon" aria-hidden="true">✳</span><h3>Creativity</h3><p>Making room for exploration, original ideas and unexpected discoveries.</p></article><article class="value-box"><span class="value-box__icon" aria-hidden="true">↗</span><h3>Independence</h3><p>Helping learners take ownership of decisions and the way they learn.</p></article></div></div></section>

  <section class="section-space section-soft">
    <div class="container">
      <SectionHeading eyebrow="The journey behind the idea" title="A foundation in technical education." align="center" />
      <div class="timeline">
        <div class="timeline__item">
          <span>1976</span>
          <div>
            <h3>Early organisational roots</h3>
          </div>
        </div>
        <div class="timeline__item">
          <span>1989</span>
          <div>
            <h3>Into training and consulting</h3>
          </div>
        </div>
        <div class="timeline__item">
          <span>2004</span>
          <div>
            <h3>MIT Academy</h3>
          </div>
        </div>
        <div class="timeline__item">
          <span>2019</span>
          <div>
            <h3>MITstem International School concept</h3>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTA title="Every future starts with a question." description="Learn more about the school vision and ask the MITstem team about its current plans and educational programmes." />
</BaseLayout>
