---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTA from '../components/CTA.astro';
import { pathways, school } from '../data/content';
---
<BaseLayout title="Learning today. Leading tomorrow" description="Discover the MITstem International School concept: Cambridge learning pathways, science, technology, engineering and mathematics, and a future-focused approach to education.">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="container home-hero__layout">
      <div class="home-hero__copy">
        <p class="eyebrow eyebrow--white"><span class="eyebrow__line"></span>MITstem International School</p>
        <h1 id="home-title">Built for what’s <span>next.</span></h1>
        <p>Where curiosity meets discovery. Explore a school vision that brings strong academics, hands-on STEM learning and creativity together to help young minds imagine a bigger future.</p>
        <div class="home-hero__buttons">
          <a class="btn btn--red" href="/academics/">Explore our curriculum <span aria-hidden="true">↗</span></a>
          <a class="btn btn--outline-light" href="/about/">Discover MITstem <span aria-hidden="true">↗</span></a>
        </div>
        <div class="home-hero__footer"><div class="home-hero__avatars" aria-hidden="true"><span>✳</span><span>+</span><span>✦</span></div><p>Science. Technology. Engineering. Mathematics. Possibility.</p></div>
      </div>
      <div class="home-hero__art">
        <span class="home-hero__orbit" aria-hidden="true"></span>
        <div class="home-hero__image-frame"><img src="/images/hero-students.webp" alt="Young students beside an illustrated robotic arm, from the MITstem prospectus" width="780" height="800" fetchpriority="high" /></div>
        <div class="home-hero__bubble home-hero__bubble--top"><span class="home-hero__bubble-icon" aria-hidden="true">✳</span><span><strong>Think beyond textbooks</strong><small>Explore. Create. Experiment.</small></span></div>
        <div class="home-hero__bubble home-hero__bubble--bottom"><span class="home-hero__bubble-icon" aria-hidden="true">↗</span><span><strong>Future-minded learning</strong><small>Skills for a changing world</small></span></div>
      </div>
    </div>
  </section>

  <section class="quick-values" aria-label="Our learning priorities">
    <div class="container quick-values__grid">
      <div class="quick-value"><span class="quick-value__icon" aria-hidden="true">✳</span><div><h3>STEM at the centre</h3><p>Connecting academic ideas with the world of technology.</p></div></div>
      <div class="quick-value"><span class="quick-value__icon" aria-hidden="true">◎</span><div><h3>A pathway for every stage</h3><p>From primary foundations through advanced study.</p></div></div>
      <div class="quick-value"><span class="quick-value__icon" aria-hidden="true">↗</span><div><h3>Creativity in action</h3><p>Growing curious, independent and collaborative learners.</p></div></div>
    </div>
  </section>

  <section class="section-space" aria-labelledby="about-title">
    <div class="container about-feature">
      <div class="about-feature__visual">
        <img src="/images/science-discovery.webp" width="650" height="670" loading="lazy" alt="Student exploring science using a microscope" />
        <img class="about-feature__floating" src="/images/lab-team.webp" width="382" height="245" loading="lazy" alt="Learners collaborating during an educational activity" />
        <span class="about-feature__label">Curiosity changes everything ↗</span>
      </div>
      <div class="about-feature__content">
        <p class="eyebrow"><span class="eyebrow__line"></span>Welcome to MITstem</p>
        <h2 id="about-title">A school vision with <em>more to discover.</em></h2>
        <p class="lead">Education should inspire more than good grades. It should encourage young people to ask questions, connect ideas and grow with confidence.</p>
        <p>The MITstem outlines a warm school community built on respect, empathy, creativity and independent learning. Its approach balances academic development with personal growth and experiences beyond the classroom.</p>
        <ul class="about-feature__ticks">
          <li>Academic learning with a technological edge</li>
          <li>Personal growth and a sense of community</li>
          <li>Creative and practical learning experiences</li>
        </ul>
        <a class="text-link" href="/about/">More about our vision <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section-space section-soft" aria-labelledby="pathways-title">
    <div class="container">
      <div class="pathways-header">
        <div class="section-heading"><p class="eyebrow"><span class="eyebrow__line"></span>Learning pathways</p><h2 id="pathways-title">Every stage is a new opportunity.</h2><p class="section-heading__description">Explore the Cambridge curriculum pathway and educational stages described in the MITstem.</p></div>
        <a href="/academics/" class="text-link">View academic details <span aria-hidden="true">→</span></a>
      </div>
      <div class="pathways-grid">
        {pathways.map((item) => (
          <article class:list={['pathway-card', `pathway-card--${item.color}`]}>
            <div class="pathway-card__top"><span class="pathway-card__number">{item.number}</span><span class="pathway-card__arrow" aria-hidden="true">↗</span></div>
            <div class="pathway-card__content"><span class="pathway-card__stage">{item.stage}</span><h3>{item.title}</h3><p>{item.summary}</p><div class="pathway-card__meta"><span>{item.years}</span><span>{item.ages}</span></div></div>
          </article>
        ))}
      </div>
      <p class="pathways-footnote">* Ages, stages and qualifications are reproduced from the 2019–2020 prospectus for reference; current offerings require confirmation.</p>
    </div>
  </section>

  <section class="section-space" aria-labelledby="stem-intro-title">
    <div class="container stem-intro">
      <div class="stem-intro__copy">
        <p class="eyebrow"><span class="eyebrow__line"></span>Learning beyond the ordinary</p>
        <h2 id="stem-intro-title">Not just learning about the future. <em>Exploring it.</em></h2>
        <p>The MITstem curriculum concept introduces the world of robotics, connected technology, automation, science and 3D design. The aim is to connect what students learn to how the world works.</p>
        <p>From understanding a scientific idea to solving a technical challenge, STEM offers a different way of thinking: curious, collaborative and hands-on.</p>
        <div class="stem-pill-row"><span class="stem-pill">Robotics</span><span class="stem-pill">Coding & ICT</span><span class="stem-pill">3D Design</span><span class="stem-pill">Automation</span></div>
        <a class="btn btn--red" href="/stem/">Explore STEM learning <span aria-hidden="true">↗</span></a>
      </div>
      <div class="stem-intro__art"><img src="/images/coding-student.webp" width="855" height="710" loading="lazy" alt="Young student learning using a computer" /><span class="stem-intro__badge">Imagine it. Understand it. Build it.</span></div>
    </div>
  </section>

  <section class="section-space featured-stem" aria-labelledby="featured-stem-title">
    <div class="container">
      <div class="featured-stem__head"><div class="section-heading section-heading--light"><p class="eyebrow eyebrow--white"><span class="eyebrow__line"></span>Future-focused subjects</p><h2 id="featured-stem-title">Big ideas start with small discoveries.</h2><p class="section-heading__description">A glimpse into the technical learning areas highlighted in the original school prospectus.</p></div><a class="text-link" href="/stem/">See all learning areas <span aria-hidden="true">→</span></a></div>
      <div class="featured-stem__grid">
        <article class="featured-card"><span class="featured-card__symbol" aria-hidden="true">⌘</span><h3>Robotics & Mechatronics</h3><p>Discover how mechanics, electronics and programming come together in the technologies around us.</p><span class="featured-card__tag">Explore · Build · Test</span></article>
        <article class="featured-card"><span class="featured-card__symbol" aria-hidden="true">{`</>`}</span><h3>Coding & Connected Tech</h3><p>Develop computational thinking and get to know the connected world through ICT and IoT topics.</p><span class="featured-card__tag">Think · Code · Connect</span></article>
        <article class="featured-card"><span class="featured-card__symbol" aria-hidden="true">◇</span><h3>Design & 3D Making</h3><p>Turn curiosity into creative solutions through digital modelling, 3D printing and CAD/CAM ideas.</p><span class="featured-card__tag">Imagine · Design · Create</span></article>
      </div>
    </div>
  </section>

  <section class="section-space school-life" aria-labelledby="life-title">
    <div class="container">
      <div class="school-life__header"><div class="section-heading"><p class="eyebrow"><span class="eyebrow__line"></span>Beyond the classroom</p><h2 id="life-title">Room to learn, play and grow.</h2><p class="section-heading__description">The school vision includes enrichment, co-curricular activity and opportunities to discover different interests.</p></div><a class="text-link" href="/about/">Explore the school approach <span aria-hidden="true">→</span></a></div>
      <div class="life-gallery">
        <div class="life-gallery__item"><img src="/images/technology-class.webp" width="339" height="277" loading="lazy" alt="Instructor guiding a learner during a technical lesson" /><span>Learn together ↗</span></div>
        <div class="life-gallery__item"><img src="/images/active-learning.webp" width="380" height="252" loading="lazy" alt="Students taking part in an outdoor sporting activity" /><span>Find your interests ↗</span></div>
        <div class="life-gallery__item"><img src="/images/engineering-tour.webp" width="500" height="685" loading="lazy" alt="Engineers on an industrial learning visit" /><span>See what’s possible ↗</span></div>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
