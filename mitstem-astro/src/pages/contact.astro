---
import BaseLayout from '../layouts/BaseLayout.astro';
import { school } from '../data/content';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---
<BaseLayout title="Contact and enquiries" description="Contact MITstem International School using the phone number and address in its historical prospectus, or submit a secure online enquiry.">
  <section class="page-hero"><div class="container page-hero__content"><p class="eyebrow eyebrow--white"><span class="eyebrow__line"></span>Get in touch</p><h1>Every great journey begins with a hello.</h1><p>Whether you have questions about the school vision, a programme or admissions, you can start the conversation here.</p></div></section>
  <section class="section-space section-soft"><div class="container contact-grid"><div class="contact-details"><p class="eyebrow"><span class="eyebrow__line"></span>Contact information</p><h2>We’d love to hear from you.</h2><p>The contact details below are transcribed from the 2019–2020 prospectus and have not been independently verified as current.</p><div class="contact-detail"><div class="contact-detail__label">Telephone</div><a href={`tel:${school.phoneHref}`}>{school.phoneDisplay}</a></div><div class="contact-detail"><div class="contact-detail__label">Email</div><a href={`mailto:${school.email}`}>{school.email}</a></div><div class="contact-detail"><div class="contact-detail__label">Address in the prospectus</div><address>{school.address}</address></div></div>
    <div class="form-card"><h2>Send us an enquiry.</h2><p>Complete the form and we will store your enquiry securely for the admissions team to review. Please do not enter sensitive student records or identity numbers.</p>
      <form class="enquiry-form" id="enquiry-form" novalidate>
        <div class="form-row"><div class="form-field"><label for="parent-name">Your name *</label><input id="parent-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="120" placeholder="Full name" required /></div><div class="form-field"><label for="parent-email">Email address *</label><input id="parent-email" name="email" type="email" autocomplete="email" maxlength="254" placeholder="you@example.com" required /></div></div>
        <div class="form-row"><div class="form-field"><label for="parent-phone">Contact number</label><input id="parent-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" placeholder="+60 …" /></div><div class="form-field"><label for="learning-stage">Interested learning stage</label><select id="learning-stage" name="stage"><option value="Not specified">Please select</option><option>Primary</option><option>Lower secondary</option><option>IGCSE / O Level</option><option>AS / A Level</option><option>General enquiry</option></select></div></div>
        <div class="form-field"><label for="message">Your message *</label><textarea id="message" name="message" minlength="10" maxlength="3000" placeholder="Tell us what you would like to know about…" required></textarea></div>
        <div class="form-field"><label class="consent-label"><input type="checkbox" name="consent_to_contact" required /> I agree that MITstem may store my enquiry and contact me regarding my request. *</label></div>
        <div aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden"><label for="company-name">Leave this blank</label><input type="text" name="company" id="company-name" tabindex="-1" autocomplete="off" /></div>
        {siteKey ? <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light"></div> : <p role="alert">This form is not enabled yet. The website administrator needs to configure Turnstile.</p>}
        <div class="form-submit"><button class="btn btn--red" type="submit" disabled={!siteKey}>Send enquiry <span aria-hidden="true">→</span></button><small>Submissions are stored in MITstem's enquiry database, accessible only to authorized staff.</small></div>
        <p id="form-status" class="form-status" role="status" aria-live="polite" hidden></p>
      </form>
    </div></div><div class="container"><div class="map-placeholder"><div class="map-placeholder__content"><p class="eyebrow"><span class="eyebrow__line"></span>Location in the prospectus</p><h3>Kota Kemuning, Shah Alam</h3><p>Selangor, Malaysia. Confirm the current location before travelling.</p></div><a class="btn btn--red" href="https://www.google.com/maps/search/?api=1&query=Kota+Kemuning+Shah+Alam+Selangor+Malaysia" target="_blank" rel="noopener noreferrer">View the area on Maps <span aria-hidden="true">↗</span></a></div></div>
  </section>
</BaseLayout>
{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  const form = document.querySelector<HTMLFormElement>('#enquiry-form');
  const status = document.querySelector<HTMLElement>('#form-status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const fields = new FormData(form);
    const read = (key: string) => String(fields.get(key) ?? '').trim();
    if (status) { status.hidden = false; status.textContent = 'Sending your enquiry…'; }
    if (button) button.disabled = true;
    try {
      const result = await fetch('/api/enquiries', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: read('name'), email: read('email'), phone: read('phone'),
          stage: read('stage'), message: read('message'), company: read('company'),
          consent_to_contact: fields.get('consent_to_contact') === 'on',
          turnstile_token: read('cf-turnstile-response'),
        }),
      });
      const response = await result.json() as { success?: boolean; error?: string };
      if (!result.ok || !response.success) throw new Error(response.error || 'Could not submit the form.');
      form.reset();
      if (status) status.textContent = 'Thank you. Your enquiry was sent successfully.';
    } catch (error) {
      if (status) status.textContent = error instanceof Error ? error.message : 'Something went wrong. Please try again.';
    } finally {
      if (button) button.disabled = false;
      const cfWindow = window as Window & { turnstile?: { reset: () => void } };
      cfWindow.turnstile?.reset();
    }
  });
</script>
