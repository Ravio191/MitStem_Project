
---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTA from '../components/CTA.astro';
import { school } from '../data/content';
---

<BaseLayout title="Admissions enquiries" description="Explore how to enquire about MITstem International School, its learning stages, school status, admissions and curriculum availability.">

  <section class="page-hero">
    <div class="container page-hero__content">
      <p class="eyebrow eyebrow--white">
        <span class="eyebrow__line"></span>Join the conversation
      </p>
      <h1>Discover what the next chapter could look like.</h1>
      <p>Choosing a school is an important decision. Start by asking questions about the school, programmes and what matters most to your family.</p>
    </div>
  </section>

  <section class="section-space">
    <div class="container">
      <SectionHeading
        eyebrow="A good place to begin"
        title="Four simple conversation starters."
        description="This is a suggested enquiry guide, not a published or verified admissions procedure."
      />
      <div class="admissions-steps">
        <article class="admissions-step">
          <span class="admissions-step__num">01</span>
          <h3>Tell us about your needs</h3>
          <p>Share your child’s learning stage, interests and questions.</p>
        </article>
        <article class="admissions-step">
          <span class="admissions-step__num">02</span>
          <h3>Explore the curriculum</h3>
          <p>Discuss the latest availability of Cambridge and STEM-related programmes.</p>
        </article>
        <article class="admissions-step">
          <span class="admissions-step__num">03</span>
          <h3>Ask about visiting</h3>
          <p>Request information about a meeting or a potential campus visit, where available.</p>
        </article>
        <article class="admissions-step">
          <span class="admissions-step__num">04</span>
          <h3>Confirm the details</h3>
          <p>Ask for current admission criteria, fees, dates, status and supporting documents.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-space section-soft">
    <div class="container story-grid admissions-decision">
      <div>
        <p class="eyebrow">
          <span class="eyebrow__line"></span>Before applying
        </p>
        <h2>Make an informed decision.</h2>
      </div>
      <div class="story-grid__copy">
        <a class="btn btn--red" href="/contact/">
          Contact admissions <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Updated Frequently Asked Questions -->
  <section class="section-space">
    <div class="container">
      <SectionHeading
        eyebrow="Frequently asked questions"
        title="Questions worth asking."
        align="center"
      />

      <div class="faq-list">

        <details>
          <summary>What academic programmes does MITstem International School offer?</summary>
          <p>
            MITstem outlines Cambridge Primary,
            Cambridge Lower Secondary, Cambridge IGCSE / O Level,
            and Cambridge Advanced AS / A Level pathways.
            These programmes aim to develop academic knowledge,
            critical thinking, creativity and practical skills.
            Please contact the school to confirm current
            programme availability.
          </p>
        </details>

        <details>
          <summary>What subjects are included in the school curriculum?</summary>
          <p>
            The curriculum described in the prospectus includes
            English, Mathematics, Science, Malay, Mandarin,
            ICT, Art and other subjects depending on the
            academic level. Secondary students may also explore
            technical subjects such as Robotics, Mechatronics,
            Programming and 3D Printing.
          </p>
        </details>

        <details>
          <summary>How does MITstem integrate STEM into its education?</summary>
          <p>
            MITstem places emphasis on Science, Technology,
            Engineering and Mathematics (STEM). Its proposed
            learning approach combines academic knowledge with
            hands-on activities in areas such as Robotics,
            Automation, Programming, Electronics and
            3D Design to develop problem-solving and
            innovation skills.
          </p>
        </details>

        <details>
          <summary>Does MITstem International School provide online learning?</summary>
          <p>
            MITstem describes technology-enhanced
            learning resources, including e-learning materials
            and a Learning Management System (LMS).
            Please contact the school to confirm whether
            online classes, remote learning or blended
            learning options are currently available.
          </p>
        </details>

        <details>
          <summary>Can students access learning materials outside the classroom?</summary>
          <p>
            MITstem describes digital learning resources
            intended to support independent study and
            continued learning beyond classroom activities.
            Access to learning platforms, digital materials
            and online assignments depends on the school's
            current learning arrangements.
          </p>
        </details>

      </div>
    </div>
  </section>

  <CTA
    title="Let's find answers together."
    description="Get in touch to request the most current and accurate admissions information."
  />

</BaseLayout>

<style>
  .admissions-decision {
    max-width: 950px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
  }

  .admissions-decision > div:first-child {
    max-width: 550px;
    min-width: 0;
  }

  .admissions-decision .story-grid__copy {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  @media (max-width: 768px) {
    .admissions-decision {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
  }
</style>
